rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUserVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'anonymous');
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (request.auth.token.email == "secret@x.com" || request.auth.token.email == "jonassantosclaro@gmail.com")) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSeedingAllowed() {
      return !exists(/databases/$(database)/documents/admins/bootstrap_secret);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Collection rules

    // 1. PRODUCTS
    match /products/{productId} {
      allow read: if true; // Public list and details
      allow create, delete, update: if true;
    }

    // 2. BRANDS
    match /brands/{brandId} {
      allow read: if true; // Public list
      allow write: if isAdmin() || isSeedingAllowed(); // Admin CRUD or Seeding
    }

    // 3. COUPONS
    match /coupons/{couponId} {
      allow read: if true; // Anyone can check coupon codes to validate at checkout
      allow write: if isAdmin() || isSeedingAllowed(); // Admin CRUD or Seeding
    }

    // 4. SOCIALS / SETTINGS
    match /socials/{docId} {
      allow read: if true; // Public social links
      allow write: if isAdmin() || isSeedingAllowed(); // Admin editing or Seeding
    }

    // 5. ORDERS
    match /orders/{orderId} {
      // Anyone can place an order (allowing Guest and Authenticatos)
      allow create: if true;
      
      // Only the Admin or the Creator of the order (matched by email) can read the order details
      allow get: if (isSignedIn() && request.auth.token.email != null && existing().customerEmail == request.auth.token.email) || isAdmin();
      allow list: if (isSignedIn() && request.auth.token.email != null && resource.data.customerEmail == request.auth.token.email) || isAdmin();
      
      // Only admins can update (status check-off, POS etc) or delete orders
      allow update, delete: if isAdmin();
    }

    // 6. ADMIN REFERENCE
    match /admins/{uid} {
      allow read: if true; // Allow checking if uid is admin
      allow write: if (isSignedIn() && request.auth.token.email != null && request.auth.token.email == "secret@x.com") || isAdmin() || isSeedingAllowed();
    }

    // 7. USER PROFILES
    match /users/{userId} {
      allow read, write: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
    }

    // 8. CATEGORIES
    match /categories/{categoryId} {
      allow read: if true; // Public list
      allow write: if isAdmin() || isSeedingAllowed(); // Admin CRUD or Seeding
    }
  }
}
