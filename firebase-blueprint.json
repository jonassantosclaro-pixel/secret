{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Premium perfume product in the store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "price": { "type": "number" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "stock": { "type": "number" },
        "category": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "brand", "price", "description", "imageUrl", "stock", "category"]
    },
    "Brand": {
      "title": "Brand",
      "description": "Perfume brand details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "logoUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "logoUrl"]
    },
    "Order": {
      "title": "Order",
      "description": "Order submitted by customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "couponCode": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "customerEmail", "customerPhone", "items", "subtotal", "tax", "total", "status"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupon for checkout",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "type": { "type": "string", "enum": ["percentage", "fixed"] },
        "value": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "type", "value"]
    },
    "Socials": {
      "title": "Socials",
      "description": "Social media links for the app",
      "type": "object",
      "properties": {
        "whatsapp": { "type": "string" },
        "instagram": { "type": "string" },
        "facebook": { "type": "string" },
        "tiktok": { "type": "string" }
      },
      "required": ["whatsapp"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Stores user ID for admins",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Perfume products collection"
    },
    "/brands/{brandId}": {
      "schema": "Brand",
      "description": "Available product brands"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase orders"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Store discount coupons"
    },
    "/socials/global": {
      "schema": "Socials",
      "description": "Store configuration custom social links"
    },
    "/admins/{uid}": {
      "schema": "Admin",
      "description": "Admin configuration lookup list"
    }
  }
}
